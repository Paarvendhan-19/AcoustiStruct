# ============================================================
# AcoustiStruct Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://acoustistruct:acoustistruct@localhost:5432/acoustistruct
DATABASE_ECHO=false

# ---- Redis (optional, for caching/queues) ----
# REDIS_URL=redis://localhost:6379/0

# ---- ASR Providers ----
# Set to: mock | sarvam | whisper | google
ASR_PROVIDER=mock
# SARVAM_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ---- Semantic/LLM Providers ----
# Set to: mock | gemini | openai
SEMANTIC_PROVIDER=mock
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ---- Language Detection ----
# Set to: mock | fasttext | google
LANGUAGE_PROVIDER=mock

# ---- Document Generation ----
DOCUMENT_OUTPUT_DIR=./generated_docs

# ---- File Storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Auth ----
JWT_SECRET_KEY=change-me-to-a-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ---- Logging ----
LOG_LEVEL=INFO
LOG_SENSITIVE_DATA=false

# ---- Demo Mode ----
DEMO_MODE=true
